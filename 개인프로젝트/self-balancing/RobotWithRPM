#include <Wire.h>
#include <SoftwareSerial.h>


// =====================================================
// Wireless
// =====================================================

SoftwareSerial serial_SW_wireless_module(8, 9);


// =====================================================
// MPU6050
// =====================================================

int gyro_address = 0x68;

// 가속도 센서 보정값
int acc_calibration_value = -75;


// =====================================================
// PID Settings
//
// ★ 기존 YABR 값 그대로
//
// 이제 pid_output의 의미:
//      목표 Motor RPM
//
// 예:
//   pid_output =  100  -> +100 RPM
//   pid_output = -100  -> -100 RPM
//   pid_output =  400  -> +400 RPM
// =====================================================

float pid_p_gain = 9.0;
float pid_i_gain = 1.0;
float pid_d_gain = 15.0;

float turning_speed = 30.0;
float max_target_speed = 150.0;


// =====================================================
// Motor Settings
// =====================================================

// PID 최대 출력 = 최대 목표 RPM
const float MAX_RPM = 400.0;

// YABR Motor
// Full step = 1.8°
// 360 / 1.8 = 200 step/rev
const int FULL_STEP_PER_REV = 200;

// Driver = 1/4 microstep
const int MICROSTEP = 4;

// 200 * 4 = 800 pulse/rev
const int STEP_PER_REV =
    FULL_STEP_PER_REV * MICROSTEP;


// Timer2 ISR
//
// 20 us마다 인터럽트
//
// 1 / 20us = 50,000 Hz
const float TIMER_ISR_FREQ = 50000.0;


// =====================================================
// Global Variables
// =====================================================

byte start;
byte received_byte;
byte low_bat;


// Motor variables
int left_motor;
int throttle_left_motor;
int throttle_counter_left_motor;
int throttle_left_motor_memory;

int right_motor;
int throttle_right_motor;
int throttle_counter_right_motor;
int throttle_right_motor_memory;


// 기타
int battery_voltage;
int receive_counter;


// MPU6050 RAW
int gyro_pitch_data_raw;
int gyro_yaw_data_raw;
int accelerometer_data_raw;


// Gyro Calibration
long gyro_yaw_calibration_value;
long gyro_pitch_calibration_value;


// 4ms control loop
unsigned long loop_timer;


// Angle
float angle_gyro;
float angle_acc;
float angle;


// 자동 균형점
float self_balance_pid_setpoint;


// PID
float pid_error_temp;
float pid_i_mem;
float pid_setpoint;

float gyro_input;

float pid_output;
float pid_last_d_error;


// Left / Right RPM
float pid_output_left;
float pid_output_right;


// =====================================================
// RPM -> Motor Timer Count
//
// RPM
//  ↓
// STEP frequency
//  ↓
// Timer2 Count
//
// f_step = RPM / 60 * 800
//
// TimerPeriod = 50000 / f_step
//
// 실제 ISR 주기는
// (timer_count + 1) * 20us
//
// 따라서:
// timer_count = 50000 / f_step - 1
// =====================================================

int rpmToMotorTimer(float rpm)
{
    // -------------------------------------------------
    // 정지
    // -------------------------------------------------

    if(rpm == 0.0)
    {
        return 0;
    }


    // -------------------------------------------------
    // RPM Limit
    // -------------------------------------------------

    if(rpm > MAX_RPM)
    {
        rpm = MAX_RPM;
    }

    else if(rpm < -MAX_RPM)
    {
        rpm = -MAX_RPM;
    }


    // -------------------------------------------------
    // 방향 저장
    // -------------------------------------------------

    bool reverse = false;

    if(rpm < 0)
    {
        reverse = true;
        rpm = -rpm;
    }


    // -------------------------------------------------
    // RPM -> STEP Frequency
    //
    // 예:
    //
    // 100 RPM
    //
    // = 100 / 60 * 800
    //
    // = 1333.33 Hz
    // -------------------------------------------------

    float step_frequency =
        (rpm / 60.0) * STEP_PER_REV;


    // -------------------------------------------------
    // STEP Frequency -> Timer Count
    //
    // Timer2 ISR = 50000 Hz
    //
    // 100 RPM라면
    //
    // 50000 / 1333.33
    //
    // = 37.5 ISR
    //
    // 실제 코드가
    // counter > memory
    // 조건이므로 -1
    // -------------------------------------------------

    float timer_period =
        TIMER_ISR_FREQ / step_frequency;


    int timer_count =
        (int)(timer_period + 0.5) - 1;


    // STEP pulse는 HIGH / LOW가 필요하므로
    // 너무 작은 timer count 방지
    if(timer_count < 2)
    {
        timer_count = 2;
    }


    // -------------------------------------------------
    // 방향
    // -------------------------------------------------

    if(reverse)
    {
        timer_count *= -1;
    }


    return timer_count;
}


// =====================================================
// SETUP
// =====================================================

void setup()
{
    serial_SW_wireless_module.begin(38400);

    Serial.begin(19200);


    // -------------------------------------------------
    // I2C
    // -------------------------------------------------

    Wire.begin();

    // 400kHz I2C
    TWBR = 12;


    // -------------------------------------------------
    // Timer2
    //
    // 20us마다 ISR 발생
    // -------------------------------------------------

    TCCR2A = 0;
    TCCR2B = 0;

    TIMSK2 |= (1 << OCIE2A);

    // Prescaler = 8
    TCCR2B |= (1 << CS21);

    // 16MHz / 8
    //
    // OCR2A = 39
    //
    // = 20us
    OCR2A = 39;

    // CTC mode
    TCCR2A |= (1 << WGM21);


    // =================================================
    // MPU6050 Setup
    // =================================================


    // -------------------------------------------------
    // Wake Up
    // -------------------------------------------------

    Wire.beginTransmission(gyro_address);

    Wire.write(0x6B);
    Wire.write(0x00);

    Wire.endTransmission();


    // -------------------------------------------------
    // Gyro ±250 deg/s
    // -------------------------------------------------

    Wire.beginTransmission(gyro_address);

    Wire.write(0x1B);
    Wire.write(0x00);

    Wire.endTransmission();


    // -------------------------------------------------
    // Accelerometer ±4g
    // -------------------------------------------------

    Wire.beginTransmission(gyro_address);

    Wire.write(0x1C);
    Wire.write(0x08);

    Wire.endTransmission();


    // -------------------------------------------------
    // DLPF ≈ 43 Hz
    // -------------------------------------------------

    Wire.beginTransmission(gyro_address);

    Wire.write(0x1A);
    Wire.write(0x03);

    Wire.endTransmission();


    // =================================================
    // Motor Pins
    // =================================================

    pinMode(2, OUTPUT);
    pinMode(3, OUTPUT);

    pinMode(4, OUTPUT);
    pinMode(5, OUTPUT);

    pinMode(13, OUTPUT);


    // =================================================
    // Gyro Calibration
    //
    // ★ 기존 YABR 그대로
    // =================================================

    for(receive_counter = 0;
        receive_counter < 500;
        receive_counter++)
    {
        if(receive_counter % 15 == 0)
        {
            digitalWrite(
                13,
                !digitalRead(13)
            );
        }


        Wire.beginTransmission(gyro_address);

        Wire.write(0x43);

        Wire.endTransmission();


        Wire.requestFrom(
            gyro_address,
            4
        );


        gyro_yaw_calibration_value +=
            Wire.read() << 8 |
            Wire.read();


        gyro_pitch_calibration_value +=
            Wire.read() << 8 |
            Wire.read();


        delayMicroseconds(3700);
    }


    gyro_pitch_calibration_value /= 500;

    gyro_yaw_calibration_value /= 500;


    // =================================================
    // Control Loop = 4ms
    // =================================================

    loop_timer = micros() + 4000;
}


// =====================================================
// LOOP
// =====================================================

void loop()
{

    // =================================================
    // Wireless Controller
    // =================================================

    if(serial_SW_wireless_module.available())
    {
        received_byte =
            serial_SW_wireless_module.read();

        receive_counter = 0;
    }


    // 받은 명령은 약 100ms 동안 유지
    if(receive_counter <= 25)
    {
        receive_counter++;
    }

    else
    {
        received_byte = 0x00;
    }


    // =================================================
    // Accelerometer Angle
    //
    // ★ 기존 YABR 그대로
    // =================================================

    Wire.beginTransmission(gyro_address);

    Wire.write(0x3F);

    Wire.endTransmission();


    Wire.requestFrom(
        gyro_address,
        2
    );


    accelerometer_data_raw =
        Wire.read() << 8 |
        Wire.read();


    // 가속도 센서 offset
    accelerometer_data_raw +=
        acc_calibration_value;


    // ±4g 설정에서 YABR 기준값
    if(accelerometer_data_raw > 8200)
    {
        accelerometer_data_raw = 8200;
    }

    if(accelerometer_data_raw < -8200)
    {
        accelerometer_data_raw = -8200;
    }


    // 가속도 기반 각도
    angle_acc =
        asin(
            (float)accelerometer_data_raw
            / 8200.0
        )
        * 57.296;


    // =================================================
    // Start
    // =================================================

    if(
        start == 0
        &&
        angle_acc > -0.25
        &&
        angle_acc < 0.25
      )
    {
        angle_gyro = angle_acc;

        start = 1;
    }


    // =================================================
    // Gyroscope
    // =================================================

    Wire.beginTransmission(gyro_address);

    Wire.write(0x43);

    Wire.endTransmission();


    Wire.requestFrom(
        gyro_address,
        4
    );


    gyro_yaw_data_raw =
        Wire.read() << 8 |
        Wire.read();


    gyro_pitch_data_raw =
        Wire.read() << 8 |
        Wire.read();


    // -------------------------------------------------
    // Pitch Offset 제거
    // -------------------------------------------------

    gyro_pitch_data_raw -=
        gyro_pitch_calibration_value;


    // -------------------------------------------------
    // Gyro integration
    //
    // 기존 YABR 그대로
    // -------------------------------------------------

    angle_gyro +=
        gyro_pitch_data_raw
        * 0.000031;


    // =================================================
    // Yaw Compensation
    //
    // 로봇 회전시 pitch angle 오차 보정
    // ★ 기존 YABR 그대로
    // =================================================

    gyro_yaw_data_raw -=
        gyro_yaw_calibration_value;


    angle_gyro -=
        gyro_yaw_data_raw
        * 0.0000003;


    // =================================================
    // Complementary Filter
    //
    // ★ 기존 YABR 그대로
    // =================================================

    angle_gyro =
        angle_gyro * 0.9995
        +
        angle_acc * 0.0005;


    // =================================================
    // PID Controller
    //
    // 출력값 = 목표 RPM
    //
    // ★ 계산 방식은 기존 YABR 그대로
    // =================================================


    // -------------------------------------------------
    // Angle Error
    // -------------------------------------------------

    pid_error_temp =
        angle_gyro
        -
        self_balance_pid_setpoint
        -
        pid_setpoint;


    // -------------------------------------------------
    // YABR의 기존 출력 되먹임 보정
    //
    // ★ 그대로 유지
    // -------------------------------------------------

    if(
        pid_output > 10
        ||
        pid_output < -10
      )
    {
        pid_error_temp +=
            pid_output * 0.015;
    }


    // -------------------------------------------------
    // I Controller
    // -------------------------------------------------

    pid_i_mem +=
        pid_i_gain
        *
        pid_error_temp;


    if(pid_i_mem > MAX_RPM)
    {
        pid_i_mem = MAX_RPM;
    }

    else if(pid_i_mem < -MAX_RPM)
    {
        pid_i_mem = -MAX_RPM;
    }


    // -------------------------------------------------
    // PID
    //
    // 이제 최종 단위를 RPM으로 해석
    // -------------------------------------------------

    pid_output =
          pid_p_gain
          * pid_error_temp

        + pid_i_mem

        + pid_d_gain
          *
          (
              pid_error_temp
              -
              pid_last_d_error
          );


    // -------------------------------------------------
    // ±400 RPM Limit
    // -------------------------------------------------

    if(pid_output > MAX_RPM)
    {
        pid_output = MAX_RPM;
    }

    else if(pid_output < -MAX_RPM)
    {
        pid_output = -MAX_RPM;
    }


    // D 항용 이전 error 저장
    pid_last_d_error =
        pid_error_temp;


    // -------------------------------------------------
    // 기존 YABR Deadband
    //
    // ±5 RPM 이하 정지
    // -------------------------------------------------

    if(
        pid_output < 5
        &&
        pid_output > -5
      )
    {
        pid_output = 0;
    }


    // =================================================
    // Fall Detection
    //
    // ★ 기존 YABR 그대로
    // =================================================

    if(
        angle_gyro > 30
        ||
        angle_gyro < -30
        ||
        start == 0
      )
    {
        pid_output = 0;

        pid_i_mem = 0;

        start = 0;

        self_balance_pid_setpoint = 0;
    }


    // =================================================
    // Left / Right Motor RPM
    // =================================================

    pid_output_left =
        pid_output;

    pid_output_right =
        pid_output;


    // =================================================
    // Turning
    //
    // 이제 turning_speed = RPM
    //
    // 예:
    // Left +30RPM
    // Right -30RPM
    // =================================================

    if(received_byte & B00000001)
    {
        pid_output_left +=
            turning_speed;

        pid_output_right -=
            turning_speed;
    }


    if(received_byte & B00000010)
    {
        pid_output_left -=
            turning_speed;

        pid_output_right +=
            turning_speed;
    }


    // =================================================
    // Forward
    //
    // ★ 기존 YABR 그대로
    // =================================================

    if(received_byte & B00000100)
    {
        if(pid_setpoint > -2.5)
        {
            pid_setpoint -= 0.05;
        }


        if(
            pid_output
            >
            max_target_speed * -1
          )
        {
            pid_setpoint -= 0.005;
        }
    }


    // =================================================
    // Backward
    // =================================================

    if(received_byte & B00001000)
    {
        if(pid_setpoint < 2.5)
        {
            pid_setpoint += 0.05;
        }


        if(
            pid_output
            <
            max_target_speed
          )
        {
            pid_setpoint += 0.005;
        }
    }


    // =================================================
    // Setpoint Return
    //
    // 전진/후진 명령이 없으면
    // pid_setpoint -> 0
    //
    // ★ 기존 YABR 그대로
    // =================================================

    if(!(received_byte & B00001100))
    {
        if(pid_setpoint > 0.5)
        {
            pid_setpoint -= 0.05;
        }

        else if(pid_setpoint < -0.5)
        {
            pid_setpoint += 0.05;
        }

        else
        {
            pid_setpoint = 0;
        }
    }


    // =================================================
    // Self Balance Setpoint
    //
    // ★ 기존 YABR 그대로
    //
    // 정지 상태에서 모터가 계속 한 방향으로
    // 움직이는 현상을 보정
    // =================================================

    if(pid_setpoint == 0)
    {
        if(pid_output < 0)
        {
            self_balance_pid_setpoint
                += 0.0015;
        }


        if(pid_output > 0)
        {
            self_balance_pid_setpoint
                -= 0.0015;
        }
    }


    // =================================================
    // ★ 변경된 부분
    //
    // 기존 YABR:
    //
    // 405 - 5500 / (PID + 9)
    //
    // 삭제
    //
    //
    // 현재:
    //
    // PID output
    //      ↓
    // Target RPM
    //      ↓
    // STEP frequency
    //      ↓
    // Timer Count
    // =================================================

    left_motor =
        rpmToMotorTimer(
            pid_output_left
        );


    right_motor =
        rpmToMotorTimer(
            pid_output_right
        );


    // ISR에 전달
    throttle_left_motor =
        left_motor;

    throttle_right_motor =
        right_motor;


    // =================================================
    // Loop Time = 4ms = 250Hz
    // =================================================

    while(loop_timer > micros());

    loop_timer += 4000;
}


// =====================================================
// TIMER2 ISR
//
// 20 us마다 실행
//
// ★ 기존 YABR 그대로
// =====================================================

ISR(TIMER2_COMPA_vect)
{

    // =================================================
    // LEFT MOTOR
    // =================================================

    throttle_counter_left_motor++;


    if(
        throttle_counter_left_motor
        >
        throttle_left_motor_memory
      )
    {
        throttle_counter_left_motor = 0;


        throttle_left_motor_memory =
            throttle_left_motor;


        // ---------------------------------------------
        // Reverse
        // ---------------------------------------------

        if(
            throttle_left_motor_memory
            <
            0
          )
        {
            // D3 LOW
            PORTD &=
                0b11110111;


            throttle_left_motor_memory
                *= -1;
        }

        else
        {
            // D3 HIGH
            PORTD |=
                0b00001000;
        }
    }


    // STEP HIGH
    else if(
        throttle_counter_left_motor
        ==
        1
      )
    {
        // D2 HIGH
        PORTD |=
            0b00000100;
    }


    // STEP LOW
    else if(
        throttle_counter_left_motor
        ==
        2
      )
    {
        // D2 LOW
        PORTD &=
            0b11111011;
    }


    // =================================================
    // RIGHT MOTOR
    // =================================================

    throttle_counter_right_motor++;


    if(
        throttle_counter_right_motor
        >
        throttle_right_motor_memory
      )
    {
        throttle_counter_right_motor = 0;


        throttle_right_motor_memory =
            throttle_right_motor;


        // ---------------------------------------------
        // Reverse
        // ---------------------------------------------

        if(
            throttle_right_motor_memory
            <
            0
          )
        {
            // D5 HIGH
            PORTD |=
                0b00100000;


            throttle_right_motor_memory
                *= -1;
        }

        else
        {
            // D5 LOW
            PORTD &=
                0b11011111;
        }
    }


    // STEP HIGH
    else if(
        throttle_counter_right_motor
        ==
        1
      )
    {
        // D4 HIGH
        PORTD |=
            0b00010000;
    }


    // STEP LOW
    else if(
        throttle_counter_right_motor
        ==
        2
      )
    {
        // D4 LOW
        PORTD &=
            0b11101111;
    }
}
